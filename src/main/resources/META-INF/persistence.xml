<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="MusicStreamingPU" transaction-type="JTA">

        <jta-data-source>jdbc/MusicDB</jta-data-source>

        <class>org.example.model.Artist</class>
        <class>org.example.model.Track</class>
        <class>org.example.model.User</class>
        <class>org.example.model.Playlist</class>

        <properties>
            <property name="jakarta.persistence.schema-generation.database.action"
                      value="none"/>
        </properties>

    </persistence-unit>

</persistence>
